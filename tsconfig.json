{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": ["ES2020", "DOM"],
		"strict": true,
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["@playwright/test", "node"]
	},
	"include": ["tests/**/*.ts", "playwright.config.ts"]
}
